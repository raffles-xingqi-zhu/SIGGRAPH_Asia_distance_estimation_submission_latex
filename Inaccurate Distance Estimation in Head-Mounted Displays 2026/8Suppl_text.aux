\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Average entrance pupil position relative to the HMD COP of Quest 3. n = 6295 trials.}}{3}{table.caption.5}\protected@file@percent }
\newlabel{Entrance pupil relative to intended COP}{{1}{3}{Average entrance pupil position relative to the HMD COP of Quest 3. n = 6295 trials}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Coordinate system transforms used to interpret reaching data studies. (Top) Our headset uses the largest Quest 3 eye relief setting available which results in an average eye relief viewing error of -12 mm. In panels 1-2, we show how a target point P is rendered at P’ when no stereo geometry errors are added to the system. In panel 3, the rays used to simulated viewpoint are shown to the actual user who is slightly displaced away from the ideal eye relief resulting in a perceived point P’. In panels 4-6, we describe how blind reaching and bias-corrected blind reaching can be converted from measured values into their equivalent perceived values based on the small offset delta between the actual user eye position and simulated viewpoint. (Bottom) Simulated eye relief viewing errors require another transform to interpret egocentric reach data in the simulated viewpoint world coordinates which is shown in panel 5 and 6. }}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:simulation_geometry}{{2}{4}{Coordinate system transforms used to interpret reaching data studies. (Top) Our headset uses the largest Quest 3 eye relief setting available which results in an average eye relief viewing error of -12 mm. In panels 1-2, we show how a target point P is rendered at P’ when no stereo geometry errors are added to the system. In panel 3, the rays used to simulated viewpoint are shown to the actual user who is slightly displaced away from the ideal eye relief resulting in a perceived point P’. In panels 4-6, we describe how blind reaching and bias-corrected blind reaching can be converted from measured values into their equivalent perceived values based on the small offset delta between the actual user eye position and simulated viewpoint. (Bottom) Simulated eye relief viewing errors require another transform to interpret egocentric reach data in the simulated viewpoint world coordinates which is shown in panel 5 and 6}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}Geometric Distortion Fields}{5}{subsection.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Geometric distortion fields in HMD coordinates at errors used in reaching experiments. (A,B) Direct Passthrough errors. (C,D) IPD Error. (E,F) Eye Relief Error. For viewing errors (C-F), points on the virtual image plane are not distorted. For rendering errors (A-B), distortions are the same irrespective of virtual image plane distance. Ocular parallax is on for panels A and B to visualize the effect of rendering error only.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:suppl_distortion_field}{{3}{5}{Geometric distortion fields in HMD coordinates at errors used in reaching experiments. (A,B) Direct Passthrough errors. (C,D) IPD Error. (E,F) Eye Relief Error. For viewing errors (C-F), points on the virtual image plane are not distorted. For rendering errors (A-B), distortions are the same irrespective of virtual image plane distance. Ocular parallax is on for panels A and B to visualize the effect of rendering error only}{figure.caption.7}{}}
