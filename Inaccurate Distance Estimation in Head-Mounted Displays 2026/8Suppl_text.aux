\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Distance misperception in relation to virtual image distance (VID). \textbf  {(A)} and \textbf  {(B)} show triangulation model predictions for a direct passthrough rendering error of +5.5 cm (render cameras in front of HMD CoP) and IPD viewing error of -1.2 cm (HMD IAD smaller than user IPD) for target distances at 0.5, 1.3 (VID), and 2.5 meters. The target boundary is shown in blue and the perceived boundary in is shown in red. \textbf  {(C)}-\textbf  {(E)} Distance misperception as a function of error magnitudes for user IPDs ranging from 55 mm to 75 mm. A negative value means the object is perceived as closer.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:model_predictions}{{6}{8}{Distance misperception in relation to virtual image distance (VID). \textbf {(A)} and \textbf {(B)} show triangulation model predictions for a direct passthrough rendering error of +5.5 cm (render cameras in front of HMD CoP) and IPD viewing error of -1.2 cm (HMD IAD smaller than user IPD) for target distances at 0.5, 1.3 (VID), and 2.5 meters. The target boundary is shown in blue and the perceived boundary in is shown in red. \textbf {(C)}-\textbf {(E)} Distance misperception as a function of error magnitudes for user IPDs ranging from 55 mm to 75 mm. A negative value means the object is perceived as closer}{figure.caption.10}{}}
