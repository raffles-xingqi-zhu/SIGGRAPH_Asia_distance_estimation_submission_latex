	file = {Rolland et al. - 1995 - Towards Quantifying Depth and Size Perception in V.pdf:/Users/raffleszhu/Zotero/storage/UHC7FM3E/Rolland et al. - 1995 - Towards Quantifying Depth and Size Perception in V.pdf:application/pdf},
}

