	file = {IEEE Xplore Abstract Record:/Users/raffleszhu/Zotero/storage/CGNGXWE5/9850416.html:text/html;Submitted Version:/Users/raffleszhu/Zotero/storage/56RSVN3Y/Kelly - 2023 - Distance Perception in Virtual Reality A Meta-Ana.pdf:application/pdf},
