	file = {Renner et al_2013_The perception of egocentric distances in virtual environments - A review.pdf:/Users/raffleszhu/Dropbox/zotfiles/Renner et al_2013_The perception of egocentric distances in virtual environments - A review.pdf:application/pdf},
}

@article{el_jamiy_survey_2019,
	title = {Survey on depth perception in head mounted displays: distance estimation in virtual reality, augmented reality, and mixed reality},
	volume = {13},
	rights = {http://onlinelibrary.wiley.com/{termsAndConditions}\#vor},
