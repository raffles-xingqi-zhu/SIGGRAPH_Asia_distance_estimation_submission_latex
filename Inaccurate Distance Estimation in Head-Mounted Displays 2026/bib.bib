editor = {Frederick A.A. Kingdom and Nicolaas Prins},
booktitle = {Psychophysics (Second Edition)},
publisher = {Academic Press},
edition = {Second Edition},
address = {San Diego},
pages = {55-117},
year = {2016},
isbn = {978-0-12-407156-8},
